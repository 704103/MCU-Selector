{
  "schema_version": "1.0.0",
  "row_granularity": "one exact orderable part number per row",
  "primary_key": "mcu_id",
  "source_of_truth": [
    "data/source/manufacturers.csv",
    "data/source/mcus.csv",
    "data/source/mcu_features.csv",
    "data/source/enums.json"
  ],
  "missing_value_policy": {
    "empty": "not confirmed or not available",
    "zero": "confirmed absent or count is zero",
    "false": "confirmed that the feature is absent",
    "true": "confirmed that the feature is present",
    "forbidden_text_values": ["N/A", "n/a", "unknown", "Unknown", "none", "None"]
  },
  "tables": {
    "manufacturers": {
      "file": "manufacturers.csv",
      "primary_key": "manufacturer_id",
      "fields": {
        "manufacturer_id": {"type": "string", "required": true, "description": "Stable lowercase identifier."},
        "name": {"type": "string", "required": true, "description": "Official manufacturer name."},
        "display_name": {"type": "string", "required": true, "description": "Name shown in the UI."},
        "website_url": {"type": "url", "required": true, "description": "Manufacturer website."},
        "enabled": {"type": "boolean", "required": true, "description": "Whether the manufacturer is shown in the UI."}
      }
    },
    "mcus": {
      "file": "mcus.csv",
      "primary_key": "mcu_id",
      "unique_keys": ["manufacturer_id + part_number"],
      "fields": {
        "mcu_id": {"type": "string", "required": true, "immutable": true, "description": "Stable internal identifier."},
        "manufacturer_id": {"type": "reference", "required": true, "references": "manufacturers.manufacturer_id"},
        "brand": {"type": "string", "required": true, "description": "Product brand shown in the selection table."},
        "part_number": {"type": "string", "required": true, "description": "Full orderable part number."},
        "family": {"type": "string", "required": true},
        "subfamily": {"type": "string", "required": false},
        "description": {"type": "string", "required": false},
        "lifecycle_status": {"type": "enum", "required": true, "enum": "lifecycle_status"},
        "record_status": {"type": "enum", "required": true, "enum": "record_status"},
        "visibility": {"type": "enum", "required": true, "enum": "visibility"},
        "architecture": {"type": "enum", "required": true, "enum": "architecture"},
        "core": {"type": "string", "required": true},
        "core_revision": {"type": "string", "required": false},
        "max_frequency_mhz": {"type": "number", "required": true, "unit": "MHz", "minimum": 0},
        "flash_kb": {"type": "integer", "required": false, "unit": "KB", "minimum": 0},
        "sram_kb": {"type": "number", "required": false, "unit": "KB", "minimum": 0},
        "data_eeprom_kb": {"type": "number", "required": false, "unit": "KB", "minimum": 0},
        "data_eeprom_bytes": {"type": "integer", "required": false, "unit": "Bytes", "minimum": 0},
        "backup_sram_kb": {"type": "integer", "required": false, "unit": "KB", "minimum": 0},
        "rom_kb": {"type": "integer", "required": false, "unit": "KB", "minimum": 0},
        "vdd_min_v": {"type": "number", "required": false, "unit": "V", "minimum": 0},
        "vdd_max_v": {"type": "number", "required": false, "unit": "V", "minimum": 0},
        "io_voltage_min_v": {"type": "number", "required": false, "unit": "V", "minimum": 0},
        "io_voltage_max_v": {"type": "number", "required": false, "unit": "V", "minimum": 0},
        "temperature_min_c": {"type": "number", "required": false, "unit": "C"},
        "temperature_max_c": {"type": "number", "required": false, "unit": "C"},
        "low_power_mode": {"type": "boolean", "required": false},
        "package": {"type": "string", "required": false},
        "package_variant": {"type": "string", "required": false},
        "pin_count": {"type": "integer", "required": false, "minimum": 1},
        "gpio_count": {"type": "integer", "required": false, "minimum": 0},
        "fpu": {"type": "boolean", "required": false},
        "touch_key_channel_count": {"type": "integer", "required": false, "minimum": 0},
        "lcd_com_count": {"type": "integer", "required": false, "minimum": 0},
        "lcd_seg_count": {"type": "integer", "required": false, "minimum": 0},
        "audio": {"type": "boolean", "required": false},
        "infrared": {"type": "boolean", "required": false},
        "key_scan": {"type": "boolean", "required": false},
        "zero_wait_flash": {"type": "boolean", "required": false},
        "internal_oscillator": {"type": "boolean", "required": false},
        "reset_method": {"type": "string", "required": false},
        "interrupt_source_count": {"type": "integer", "required": false, "minimum": 0},
        "internal_opamp": {"type": "boolean", "required": false},
        "pre_driver_method": {"type": "string", "required": false},
        "timer_16bit_count": {"type": "integer", "required": false, "minimum": 0},
        "timer_32bit_count": {"type": "integer", "required": false, "minimum": 0},
        "timer_motor_control_count": {"type": "integer", "required": false, "minimum": 0},
        "timer_basic_count": {"type": "integer", "required": false, "minimum": 0},
        "timer_low_power_count": {"type": "integer", "required": false, "minimum": 0},
        "timer_low_power_32bit_count": {"type": "integer", "required": false, "minimum": 0},
        "timer_high_resolution_count": {"type": "integer", "required": false, "minimum": 0},
        "timer_ftmr_16bit_count": {"type": "integer", "required": false, "minimum": 0},
        "systick": {"type": "boolean", "required": false},
        "iwdt": {"type": "boolean", "required": false},
        "wwdt": {"type": "boolean", "required": false},
        "wdt": {"type": "boolean", "required": false},
        "ewdt": {"type": "boolean", "required": false},
        "adc_channel_count": {"type": "integer", "required": false, "minimum": 0},
        "adc_resolution_bits": {"type": "integer", "required": false, "minimum": 0},
        "adc_12bit_cell_count": {"type": "integer", "required": false, "minimum": 0},
        "adc_12bit_channel_count": {"type": "integer", "required": false, "minimum": 0},
        "adc_14bit_cell_count": {"type": "integer", "required": false, "minimum": 0},
        "adc_14bit_channel_count": {"type": "integer", "required": false, "minimum": 0},
        "adc_16bit_cell_count": {"type": "integer", "required": false, "minimum": 0},
        "adc_16bit_channel_count": {"type": "integer", "required": false, "minimum": 0},
        "dac_channel_count": {"type": "integer", "required": false, "minimum": 0},
        "dac_12bit_cell_count": {"type": "integer", "required": false, "minimum": 0},
        "comparator_count": {"type": "integer", "required": false, "minimum": 0},
        "opamp_count": {"type": "integer", "required": false, "minimum": 0},
        "tsc_channel_count": {"type": "integer", "required": false, "minimum": 0},
        "timer_count": {"type": "integer", "required": false, "minimum": 0},
        "pwm_channel_count": {"type": "integer", "required": false, "minimum": 0},
        "uart_count": {"type": "integer", "required": false, "minimum": 0},
        "usart_count": {"type": "integer", "required": false, "minimum": 0},
        "low_power_uart_count": {"type": "integer", "required": false, "minimum": 0},
        "spi_count": {"type": "integer", "required": false, "minimum": 0},
        "i2s_count": {"type": "integer", "required": false, "minimum": 0},
        "mspi_count": {"type": "integer", "required": false, "minimum": 0},
        "i2c_count": {"type": "integer", "required": false, "minimum": 0},
        "lpspi_count": {"type": "integer", "required": false, "minimum": 0},
        "lpi2c_count": {"type": "integer", "required": false, "minimum": 0},
        "lpuart_count": {"type": "integer", "required": false, "minimum": 0},
        "can_count": {"type": "integer", "required": false, "minimum": 0},
        "qspi_count": {"type": "integer", "required": false, "minimum": 0},
        "cec_count": {"type": "integer", "required": false, "minimum": 0},
        "fsmc_count": {"type": "integer", "required": false, "minimum": 0},
        "usb_device_count": {"type": "integer", "required": false, "minimum": 0},
        "usb_fs_host_otg_count": {"type": "integer", "required": false, "minimum": 0},
        "usb_hs_otg_count": {"type": "integer", "required": false, "minimum": 0},
        "mdio_count": {"type": "integer", "required": false, "minimum": 0},
        "dci_count": {"type": "integer", "required": false, "minimum": 0},
        "smc_count": {"type": "integer", "required": false, "minimum": 0},
        "dmc_count": {"type": "integer", "required": false, "minimum": 0},
        "sai_count": {"type": "integer", "required": false, "minimum": 0},
        "spdifrx_count": {"type": "integer", "required": false, "minimum": 0},
        "dfsdm_count": {"type": "integer", "required": false, "minimum": 0},
        "dcmi_count": {"type": "integer", "required": false, "minimum": 0},
        "swpmi_count": {"type": "integer", "required": false, "minimum": 0},
        "pdu": {"type": "boolean", "required": false},
        "rng": {"type": "boolean", "required": false},
        "aes_des": {"type": "boolean", "required": false},
        "bn_sm3_sm4": {"type": "boolean", "required": false},
        "segment_lcd": {"type": "boolean", "required": false},
        "jpeg_codec": {"type": "boolean", "required": false},
        "gpu": {"type": "boolean", "required": false},
        "gpu_3d": {"type": "boolean", "required": false},
        "tft_lcd": {"type": "boolean", "required": false},
        "mipi_dsi": {"type": "boolean", "required": false},
        "math_accelerator": {"type": "boolean", "required": false},
        "rf": {"type": "boolean", "required": false},
        "trust_zone": {"type": "boolean", "required": false},
        "otfdec": {"type": "boolean", "required": false},
        "pka": {"type": "boolean", "required": false},
        "sha_hmac": {"type": "boolean", "required": false},
        "usb": {"type": "boolean", "required": false},
        "ethernet": {"type": "boolean", "required": false},
        "sdio": {"type": "boolean", "required": false},
        "qspi": {"type": "boolean", "required": false},
        "rtc": {"type": "boolean", "required": false},
        "watchdog": {"type": "boolean", "required": false},
        "crypto_accelerator": {"type": "boolean", "required": false},
        "trng": {"type": "boolean", "required": false},
        "product_url": {"type": "url", "required": true},
        "datasheet_url": {"type": "url", "required": true},
        "sample_price": {"type": "string", "required": false, "description": "Sample price quote text, including currency and commercial conditions when known."},
        "batch_price": {"type": "string", "required": false, "description": "Volume price quote text, including quantity, currency and commercial conditions when known."},
        "source_name": {"type": "string", "required": true},
        "source_checked_at": {"type": "date", "required": true, "format": "YYYY-MM-DD"},
        "last_modified_at": {"type": "date", "required": true, "format": "YYYY-MM-DD"},
        "source_note": {"type": "string", "required": false}
      }
    },
    "mcu_features": {
      "file": "mcu_features.csv",
      "primary_key": "mcu_id + feature_code + unit",
      "fields": {
        "mcu_id": {"type": "reference", "required": true, "references": "mcus.mcu_id"},
        "feature_code": {"type": "enum", "required": true, "enum": "feature_code"},
        "value_type": {"type": "enum", "required": true, "enum": "value_type"},
        "value_bool": {"type": "boolean", "required": false},
        "value_number": {"type": "number", "required": false},
        "value_text": {"type": "string", "required": false},
        "unit": {"type": "string", "required": false},
        "source_note": {"type": "string", "required": false}
      }
    }
  }
}
